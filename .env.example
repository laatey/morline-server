# ========================================================
# Moorline Server Configuration Template (.env.example)
# ========================================================

# Server Port & Binding (Railway injects PORT automatically)
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Base Domain and Public Routing
BASE_DOMAIN=morline.space
PUBLIC_URL=https://api.morline.space

# Security & Authentication (Replace with a strong random secret)
JWT_SECRET=moorline-super-secret-production-jwt-key-2026

# Cloudflare Zero Trust Tunnel Token (Optional)
# If provided, the server starts cloudflared automatically inside the container.
# If omitted, Moorline runs in standalone HTTP mode.
CLOUDFLARE_TUNNEL_TOKEN=eyJh...

# GitHub Integration (Optional: Enables live repo listing and private repo cloning)
# GITHUB_TOKEN=ghp_your_personal_access_token_here
# GITHUB_APP_NAME=moorline

# Internal App Process Ports Range (Defaults to 4100-4999)
SERVICE_PORT_MIN=4100
SERVICE_PORT_MAX=4999

# Storage Path (On Railway this automatically defaults to /data when a volume is attached)
# DATA_DIR=/data
