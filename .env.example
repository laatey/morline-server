# ========================================================
# Moorline Server Environment Variables (Railway / Production)
# ========================================================

# Base Domain for the platform and wildcard subdomains
BASE_DOMAIN=morline.space

# Public API URL (used in CORS, OAuth callbacks, OpenAPI specs)
PUBLIC_URL=https://api.morline.space

# JWT secret key for signing user auth tokens
JWT_SECRET=replace_with_a_long_random_production_secret

# Optional: Cloudflare Zero Trust Tunnel Token
# If set, Moorline will automatically boot cloudflared inside the Railway container.
# If omitted, Moorline runs in direct HTTP mode and Railway edge routes directly.
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...

# Optional: Persistent storage path (Railway Volume)
# Defaults automatically to /data if a Railway persistent volume is attached at /data.
# DATA_DIR=/data

# Port is automatically assigned by Railway (defaults to 3001 locally)
# PORT=3001
# HOST=0.0.0.0
