# ========================================================
# Morline Server Configuration Template (.env.example)
# ========================================================

# Server Port & Binding (Railway injects PORT automatically)
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Base Domain and Public Routing
BASE_DOMAIN=morline.space
PUBLIC_URL=https://api.morline.space

# Security & Authentication (Replace with a strong random secret)
JWT_SECRET=replace_with_a_long_random_production_secret

# Cloudflare Zero Trust Tunnel Token (Optional)
# If provided, the server starts cloudflared automatically inside the container.
# If omitted, Morline runs in standalone HTTP mode.
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...

# GitHub App Integration (Recommended: provides granular repo permissions & auto-deploy webhooks)
# GITHUB_APP_ID=5132622
# GITHUB_APP_NAME=morline-cloud
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
# GITHUB_PRIVATE_KEY_BASE64=...
# GITHUB_WEBHOOK_SECRET=your_webhook_secret

# AI Assistant LLM Provider (Optional: OpenAI, Gemini, Anthropic, DeepSeek)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=...

# Internal App Process Ports Range (Defaults to 4100-4999)
SERVICE_PORT_MIN=4100
SERVICE_PORT_MAX=4999

# Storage Path (On Railway this automatically defaults to /data when a volume is attached)
# DATA_DIR=/data

# Edge Proxy (Caddy) Configuration for On-Demand TLS
# EDGE_SECRET=long_random_production_secret
# ACME_EMAIL=you@yourdomain.com
# EDGE_IPS=your_ec2_elastic_ip
