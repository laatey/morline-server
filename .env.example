# ==========================================================================
# Morline server configuration. Copy to .env (local) or /etc/morline/morline.env (production).
# Only JWT_SECRET is required in production; everything else has a default or is optional.
# ==========================================================================

# --- Server -----------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Required when NODE_ENV=production. Use a long random value (e.g. `openssl rand -hex 48`).
JWT_SECRET=

# --- Domains and URLs -------------------------------------------------------
# Services get <name>.<BASE_DOMAIN>; the API is expected at api.<BASE_DOMAIN>.
BASE_DOMAIN=morline.space
# Defaults to https://api.<BASE_DOMAIN>
# PUBLIC_URL=https://api.morline.space
# Dashboard origin. Defaults to https://<BASE_DOMAIN> (http://localhost:5173 when BASE_DOMAIN=localhost).
# FRONTEND_URL=https://morline.space
# Extra browser origins allowed to call the API, comma separated.
# CORS_ORIGINS=http://localhost:5173

# --- Storage ----------------------------------------------------------------
# Defaults to /data when it exists (Linux), otherwise ./data.
# DATA_DIR=/data
# Set when Morline itself runs in a container: the HOST path that DATA_DIR is mounted from,
# so bind mounts for customer containers resolve on the host.
# HOST_DATA_DIR=/opt/morline/data

# --- Email (Resend) ---------------------------------------------------------
# RESEND_API_KEY=

# --- GitHub App (repo access, OAuth sign-in, auto-deploy webhooks) ----------
# GITHUB_APP_ID=
# GITHUB_APP_NAME=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Required in production: unsigned push webhooks are rejected without it (it must match the secret set on the GitHub App).
# GITHUB_WEBHOOK_SECRET=
# Private key: pass ONE of these. The file default is $DATA_DIR/github-private-key.pem.
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_PRIVATE_KEY_BASE64=
# GITHUB_PRIVATE_KEY_PATH=
# Fallback clone token when no GitHub App installation or OAuth token is available.
# GITHUB_TOKEN=

# --- AI assistant and deployment diagnosis ----------------------------------
# Providers are tried in this order; the first that answers wins. Configure at least one.
# AI_GATEWAY_URL=
# AI_GATEWAY_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-5
# Cheaper model for routing and chat titles (optional)
# AI_GATEWAY_FAST_MODEL=google/gemini-3.1-flash-lite
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Private AI gateway for MoreCode ----------------------------------------
# This is a separate protected proxy, not Morline's own assistant configuration. Generate a
# unique client key for MoreCode and put it in MoreCode Settings; do not use an upstream key.
# MORLINE_AI_GATEWAY_CLIENT_KEY=
# Server-only JSON pool. Each upstream is tried once before a response begins; 402/403/429/5xx
# temporarily cool it down and move to the next compatible upstream. Keep this value in a secret
# manager in production. Example format (replace every placeholder):
# MORLINE_AI_GATEWAY_UPSTREAMS='[{"id":"primary","url":"https://gateway.example/api/public/ai","key":"provider-secret","models":["anthropic/claude-sonnet-5"]}]'
# MORLINE_AI_GATEWAY_RATE_LIMIT_PER_MIN=120

# --- Builds -----------------------------------------------------------------
# Railpack CLI and its BuildKit frontend image must be the same version.
# RAILPACK_VERSION=0.37.0
# RAILPACK_FRONTEND_IMAGE=
# Per-step build timeout in milliseconds (default 15 minutes).
# MORLINE_BUILD_TIMEOUT_MS=900000

# --- Networking -------------------------------------------------------------
# /26 networks are carved from this pool, one per environment.
# PRIVATE_NET_POOL=10.200.0.0/16
# Public ports handed out to services. Open the same ranges in the firewall / security group.
TCP_PROXY_PORTS=30000-30999
UDP_PROXY_PORTS=31000-31999
# Host customers use to reach those ports. Defaults to edge.<BASE_DOMAIN>.
# PUBLIC_TCP_HOST=
# PUBLIC_UDP_HOST=

# --- Edge proxy (Caddy, custom-domain HTTPS; see edge/README.md) ------------
# EDGE_SECRET=
# ACME_EMAIL=you@example.com
# IP shown to customers in DNS instructions, skips a DNS lookup.
# EDGE_IPS=

# --- Cloudflare Tunnel (optional) -------------------------------------------
# Only used when ENABLE_CLOUDFLARE_TUNNEL=true. TUNNEL_TOKEN is accepted as an alias.
# ENABLE_CLOUDFLARE_TUNNEL=true
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Limits and isolation ---------------------------------------------------
# Requests per minute per IP: whole API, and the /auth endpoints specifically.
# RATE_LIMIT_API_PER_MIN=1200
# RATE_LIMIT_AUTH_PER_MIN=30
# Defaults applied to customer containers that have no limits of their own.
# Small on purpose: starter apps and bots fit, and users raise limits per service with the sliders.
# On a 2 vCPU / 2 GB host (t3.small) this fits 4-5 services at once.
# MORLINE_DEFAULT_MEMORY_MB=256
# MORLINE_DEFAULT_CPUS=0.2
# MORLINE_PIDS_LIMIT=1024
# Set to 0 to drop the extra isolation flags (no-new-privileges, dropped capabilities, default limits).
# MORLINE_HARDEN=1

# Capacity the dashboard sliders draw from. Defaults to the host's CPUs and RAM minus a reserve
# for Morline itself and the OS; override when the host is shared or you want a hard cap.
# MORLINE_CAPACITY_CPUS=
# MORLINE_CAPACITY_MEMORY_MB=
# MORLINE_RESERVED_CPUS=0.5
# MORLINE_RESERVED_MEMORY_MB=

# --- Development ------------------------------------------------------------
# Stop customer containers when Morline exits (default: leave them running and re-adopt on start).
# STOP_SERVICES_ON_EXIT=1

# Module engine: new Node servers are composed from a catalog of tested modules instead of being
# written from scratch by the model. Set to "off" to use the from-scratch builder everywhere.
# MODULE_ENGINE=on
